+// A regular save can move an owned copy but only the Exchange can add or remove one.
+function sameDiamondHoldings(previous,next){
+ function holdings(city){
+  const ids=new Map();
+  function add(tile){
+   if(!tile?.diamondCopyId)return true;
+   if(typeof tile.diamondCopyId!=='string'||typeof tile.id!=='string'||ids.has(tile.diamondCopyId))return false;
+   ids.set(tile.diamondCopyId,tile.id);return true;
+  }
+  if(!Array.isArray(city?.storedBuildings??[])||!Array.isArray(city?.tiles??[]))return null;
+  for(const tile of city?.tiles??[])if(!add(tile))return null;
+  for(const entry of city?.storedBuildings??[])if(!add(entry?.building??entry))return null;
+  return ids;
+ }
+ const a=holdings(previous),b=holdings(next);
+ return a&&b&&a.size===b.size&&[...a].every(([id,model])=>b.get(id)===model);
+}
